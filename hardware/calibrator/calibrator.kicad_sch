  (text "Light sensors (display mode)" (exclude_from_sim no) (at 102.86999999999999 74.93 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left bottom)) (uuid "da3d9840-93c3-591e-8437-d1ae3ef701be"))
  (rectangle (start 162.56 25.4) (end 210.82 154.94) (stroke (width 0.254) (type dash) (color 72 110 150 1)) (fill (type none)) (uuid "e481ec6f-fd7c-5522-8fe7-9965497151cf"))
  (text "MCU" (exclude_from_sim no) (at 163.83 29.209999999999997 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left bottom)) (uuid "5844e9f0-15f4-53b7-9c3e-22596859fee5"))
  (rectangle (start 210.82 25.4) (end 279.4 154.94) (stroke (width 0.254) (type dash) (color 72 110 150 1)) (fill (type none)) (uuid "c7274ec8-f631-5968-b2d1-68cd0fbc813e"))
  (text "Flash + click (camera and display mode)" (exclude_from_sim no) (at 212.09 29.209999999999997 0) (effects (font (size 1.8 1.8) (bold yes)) (justify left bottom)) (uuid "771c5b8a-73f5-504a-a360-ad0f41415e6e"))
  (text "5.1k on CC1/CC2 asks the phone for 5 V." (exclude_from_sim no) (at 17.78 107.95 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "b864ee15-c4bc-59d2-8f8c-a95ced2f54b4"))
  (text "D+/D- go only to the MCU. The firmware never turns USB on," (exclude_from_sim no) (at 17.78 110.49 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bd799cf5-9e03-5555-ab96-fe0917cd635c"))
  (text "so a phone sees no device. R3 + C2/C3 filter spikes; C2/C3 sit at U1." (exclude_from_sim no) (at 17.78 113.03 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "60e4abe4-9bf9-5241-a089-5d8e3a9e13c9"))
  (text "Update: hold SW1 while plugging into a PC. The ROM bootloader starts" (exclude_from_sim no) (at 17.78 118.11 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "94489469-456f-5509-878f-8e5997d2e6ca"))
  (text "only at power-on with PC17 (D+) high; R9 limits the current into D+." (exclude_from_sim no) (at 17.78 120.65 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "ed2d5539-e252-5024-ac0e-4369b9b93855"))
  (text "Reverse-gullwing parts look down through holes. CMP3 (hysteresis)" (exclude_from_sim no) (at 104.14 158.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c58643cb-d473-5833-b57e-eaf4aaf5ad9d"))
  (text "flips where A and B see the same light; ADC0/ADC2 read dark / light." (exclude_from_sim no) (at 104.14 161.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "91b1a545-fad5-5cb7-82b8-c552aed05c32"))
  (text "Reverse-mount white LED shines through a hole (~12 mA)." (exclude_from_sim no) (at 213.36 158.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "20ff00a1-19ee-5a21-bf1d-ed73576784fd"))
  (text "PA4 and PA5 are set by one register write." (exclude_from_sim no) (at 213.36 161.29 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "45f2d268-f548-574e-a586-7c7b61f7843b"))
  (text "D2 catches the coil kick; R6 keeps Q1 off during reset." (exclude_from_sim no) (at 213.36 163.83 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "af96e05e-a2e2-5599-b316-4e20d52b3d39"))
