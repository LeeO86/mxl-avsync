{
  "expo": {
    "name": "mxl-avsync",
    "slug": "mxl-avsync",
    "version": "2.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "ios": {"bundleIdentifier": "io.leeo86.mxl.avsync", "infoPlist": {"NSCameraUsageDescription": "See the AV sync test picture.", "NSMicrophoneUsageDescription": "Hear the AV sync chirps."}},
    "android": {
      "package": "io.leeo86.mxl.avsync",
      "adaptiveIcon": {"foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#091426"},
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "web": {"favicon": "./assets/favicon.png"},
    "plugins": ["./modules/avsync/app.plugin.js"]
  }
}
