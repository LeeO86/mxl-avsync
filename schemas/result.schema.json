{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LeeO86/mxl-avsync/schemas/result.schema.json",
  "title": "mxl-avsync result",
  "type": "object",
  "required": ["schema", "test_id", "mode", "reference", "graded_on", "events", "statistics"],
  "properties": {
    "schema": {"const": "mxl-avsync-result/1"},
    "test_id": {"type": "string"},
    "mode": {"enum": ["FILE", "LIVE"]},
    "graded_on": {"enum": ["offset", "deviation"]},
    "reference": {
      "type": "object",
      "required": ["type", "sync_state"],
      "properties": {
        "type": {"enum": ["tai-ptp", "file", "none"]},
        "domain": {},
        "sync_state": {"type": "string"},
        "accuracy_ns": {}
      }
    },
    "stream": {"type": "object"},
    "summary": {"type": "object"},
    "statistics": {"type": "object"},
    "events": {"type": "array"}
  }
}
